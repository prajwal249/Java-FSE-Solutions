{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "student-course-portal": {
      "projectType": "application",
      "schematics": {},
      "root": ".",
      "sourceRoot": ".",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/student-course-portal",
            "index": "./index.html",
            "main": "./main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "./tsconfig.app.json",
            "assets": [],
            "styles": ["./styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "student-course-portal:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "./main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "./tsconfig.spec.json",
            "karmaConfig": "./karma.conf.js",
            "styles": ["./styles.css"],
            "scripts": [],
            "assets": []
          }
        }
      }
    }
  }
}
